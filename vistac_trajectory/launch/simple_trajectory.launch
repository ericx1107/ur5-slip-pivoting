    type="follow_simple_arc_trajectory.py" output="screen" respawn="false" />

    <node pkg="rosbag" type="record" name="record_bag"
    args="record -o /home/acrv/eric_ws/bagfiles/Experiments/heavy_short_open_no_grip_with --node=/d405/color/image_raw" 
    if="$(arg record)" />

    <!-- <node pkg="slip_manipulation" name="synchronise_data_tactile_sensor"
    type="synchronise_data_tactile_sensor.py" output="screen" respawn="true" /> -->
</launch>
