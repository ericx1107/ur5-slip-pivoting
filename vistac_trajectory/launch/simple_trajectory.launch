<launch>
    <arg name="record" default="false" />
    <arg name="server" default="192.168.1.2"/>

    <node pkg="vistac_trajectory" name="follow_simple_arc_trajectory"
    type="follow_simple_arc_trajectory.py" output="screen" respawn="false" />

    <node pkg="rosbag" type="record" name="record_bag"
    args="record -o /home/acrv/trajectory_ws/data/experiments --node=/d405/color/image_raw" 
    if="$(arg record)" />

    <node pkg="ur5_vistac_common" name="synchronise_data_tactile_sensor"
    type="synchronise_sensor_data.py" output="screen" respawn="true" if="$(arg record)"/>


</launch>
